{
  "expo": {
    "name": "Camel Ranch",
    "slug": "Booking-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "camelranch",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.camelranchbooking.app",
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.camelranchbooking.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1628",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1628",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0E1628",
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "owner": "camelranchentertainment",
    "extra": {
      "eas": {
        "projectId": "4494fc51-8717-4053-93b6-f0638cbcd983"
      },
      "apiBaseUrl": "https://www.camelranchbooking.com"
    }
  }
}
